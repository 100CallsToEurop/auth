# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (either DATABASE_URL or discrete PG* variables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=auth

# JWT (generate strong secrets, e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Публичный адрес бэкенда — из него строятся callback-URL внешних провайдеров
# (${PUBLIC_API_URL}/api/auth/external/<provider>/callback)
PUBLIC_API_URL=http://localhost:3000

# Authentik OIDC
# issuer = https://<host>/application/o/<app-slug>/ — должен совпадать с iss
# ID-токена Authentik (он выводится из хоста, на который идёт запрос токена).
# В Authentik authorize/token/userinfo лежат на общих путях БЕЗ слага приложения,
# поэтому задаются отдельно; если не заданы — выводятся как issuer + путь.
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/your-app/
AUTHENTIK_AUTHORIZATION_URL=https://authentik.example.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://authentik.example.com/application/o/token/
AUTHENTIK_USERINFO_URL=https://authentik.example.com/application/o/userinfo/
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
# Необязательно: по умолчанию ${PUBLIC_API_URL}/api/auth/external/authentik/callback
# AUTHENTIK_CALLBACK_URL=http://localhost:3000/api/auth/external/authentik/callback
AUTHENTIK_SCOPES=openid email profile

# Яндекс OAuth (https://oauth.yandex.ru → «Создать OAuth-приложение», права login:info login:email)
# Провайдер включается только при заданных CLIENT_ID/CLIENT_SECRET.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# YANDEX_CALLBACK_URL=http://localhost:3000/api/auth/external/yandex/callback
# YANDEX_SCOPES=login:info login:email

# GitHub OAuth (https://github.com/settings/developers → OAuth Apps, scope user:email)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/external/github/callback
# GITHUB_SCOPES=read:user user:email

# Invision Community OAuth2 (ACP → System → API → OAuth Clients)
# INVISION_BASE_URL — адрес сообщества, например https://community.example.com
# Redirect URI: ${PUBLIC_API_URL}/api/auth/external/invision/callback
INVISION_BASE_URL=
INVISION_CLIENT_ID=
INVISION_CLIENT_SECRET=
# INVISION_CALLBACK_URL=http://localhost:3000/api/auth/external/invision/callback
# INVISION_SCOPES=

# Session for Passport (needed for state/nonce)
SESSION_SECRET=dev-session-secret-change-me

# Schema sync: defaults to true unless NODE_ENV=production
# DB_SYNCHRONIZE=true
